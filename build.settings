--
-- For more information on build.settings, see the Solar2D Build Settings guide:
-- https://docs.coronalabs.com/guide/distribution/buildSettings/index.html
--

settings = {
    orientation = {
        default = "landscapeRight",
        supported = { "landscapeRight", "landscapeLeft" },
    },
    window = {
        defaultViewWidth = 568,
        defaultViewHeight = 320,
        title = "The Solfège Trainer",
    },
    iphone = {
        xcassets = "Images.xcassets",
        plist = {
            UIStatusBarHidden = true,
            UIViewControllerBasedStatusBarAppearance = false,
            UIInterfaceOrientation = "UIInterfaceOrientationLandscapeRight",
            UISupportedInterfaceOrientations = {
                "UIInterfaceOrientationLandscapeRight",
                "UIInterfaceOrientationLandscapeLeft"
            },
            UISupportedInterfaceOrientationsIPad = {
                "UIInterfaceOrientationLandscapeRight",
                "UIInterfaceOrientationLandscapeLeft",
                "UIInterfaceOrientationPortrait",
                "UIInterfaceOrientationPortraitUpsideDown"
            },
        },
    },
    android = {
        usesPermissions = {
            "android.permission.INTERNET",
        },
    },
    excludeFiles = {
        -- Exclude all git history, documentation, system metadata, and helper utilities from device builds
        all = {
            ".git*",
            ".gitignore",
            ".DS_Store",
            "*.md",
            "File Renamer.app*",
            "zzzz archives*",
        },
    },
}